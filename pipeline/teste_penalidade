import math

def simular_e_validar_penalidade(query_vector, doc_vector, score_oraculo):
    # 1. FUNÇÕES MATEMÁTICAS INDEPENDENTES
    def norma_l2(v):
        return math.sqrt(sum(x**2 for x in v))
    
    def produto_escalar(v1, v2):
        return sum(a * b for a, b in zip(v1, v2))

    # 2. CALCULO DO COSSENO PURO (PONTO FLUTUANTE DE ALTA PRECISÃO)
    nq = norma_l2(query_vector)
    nd = norma_l2(doc_vector)
    
    if nq == 0 or nd == 0:
        print("Erro: Vetores inválidos com norma zero.")
        return

    cosseno_puro = produto_escalar(query_vector, doc_vector) / (nq * nd)
    
    # 3. EXTRAÇÃO DO FATOR NORMATIVO GERAL (max do vetor da query)
    query_factor = max(query_vector)
    
    # Score base antes de qualquer rasteira do servidor
    if query_factor != 0:
        score_base_teorico = cosseno_puro / query_factor
    else:
        score_base_teorico = 0.0

    # 4. ENGENHARIA REVERSA DA PENALIDADE
    if score_base_teorico == 0:
        print("Erro: O score base teórico deu zero. Use outro documento candidato.")
        return
        
    penalidade_real = score_oraculo / score_base_teorico

    # 5. TESTE DE TOLERÂNCIA DE PONTO FLUTUANTE (ALVO: 1/3)
    alvo_penalidade = 1.0 / 3.0
    
    # O Python usa float de 64 bits por padrão. 
    # math.isclose verifica se os valores batem dentro da tolerância segura exigida.
    passou_na_precisao = math.isclose(penalidade_real, alvo_penalidade, rel_tol=1e-6, abs_tol=1e-6)

    # 6. RELATÓRIO DO DETETIVE DE CÓDIGO
    print("=" * 65)
    print("          VALIDADOR DE PENALIDADE E PRECISÃO DA ENGINE        ")
    print("=" * 65)
    print(f"Cosseno Puro Calculado : {cosseno_puro:.12f}")
    print(f"Fator Normativo (Max)  : {query_factor:.12f}")
    print(f"Score Teórico Puro     : {score_base_teorico:.12f}")
    print(f"Score Real do Oráculo  : {score_oraculo:.12f}")
    print("-" * 65)
    print(f"Razão de Penalidade Detectada no Oráculo : {penalidade_real:.12f}")
    print(f"Fator de Penalidade Esperada Geral (1/3) : {alvo_penalidade:.12f}")
    print("-" * 65)
    
    if passou_na_precisao:
        print(" [ STATUS: SUCESSO ]")
        print(" A regra de penalidade e a precisão batem 100% com o oráculo.")
        print(" Seu código está pronto para passar nas consultas aleatórias!")
    else:
        print(" [ STATUS: FALHA ]")
        print(" Atenção: A razão detectada diverge do valor de 1/3.")
        print(" Verifique se o documento escolhido realmente sofreu a penalidade.")
    print("=" * 65)

