import math

def testar_regra_geral(query_vector, doc_vector, score_oraculo):
    # 1. Funções matemáticas básicas de vetor
    def norma_l2(v):
        return math.sqrt(sum(x**2 for x in v))
    
    def produto_escalar(v1, v2):
        return sum(a * b for a, b in zip(v1, v2))

    # 2. Calcula o Cosseno Puro
    nq = norma_l2(query_vector)
    nd = norma_l2(doc_vector)
    cosseno_puro = produto_escalar(query_vector, doc_vector) / (nq * nd) if (nq * nd) != 0 else 0.0

    # 3. Engenharia Reversa do Fator Real da Consulta Atual
    # Como o score exibido = cosseno / fator, o fator real é:
    fator_real = cosseno_puro / score_oraculo

    # 4. Hipóteses de Generalização Matemáticas
    hipoteses = {
        "max(query)": max(query_vector),
        "max(abs(x)) [Maior Valor Absoluto]": max(abs(x) for x in query_vector),
        "min(query)": min(query_vector),
        "abs(min(query))": abs(min(query_vector)),
        "sum(query)": sum(query_vector),
        "norma_l2(query)": nq
    }

    print("=" * 60)
    print("         VALIDADOR DE GENERALIZAÇÃO E PRECISÃO       ")
    print("=" * 60)
    print(f"Fator Real extraído do Oráculo: {fator_real:.8f}")
    print("-" * 60)
    print("AVALIAÇÃO DAS REGRAS GERAIS:")
    
    for nome, valor in hipoteses.items():
        # Compara com tolerância segura de ponto flutuante (epsilon)
        is_match = math.isclose(fator_real, valor, abs_tol=1e-4)
        status = " [ COMPATÍVEL - PASSA NA VALIDAÇÃO ]" if is_match else ""
        print(f"{nome:<40}: {valor:.8f}{status}")
        
    print("=" * 60)

